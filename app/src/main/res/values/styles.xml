<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StatsText" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="layout_constraintHorizontal_chainStyle">spread_inside</item>
        <item name="android:textColor">@color/stats_text</item>
    </style>

    <style name="SelectCardButton" parent="Widget.MaterialComponents.ShapeableImageView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:padding">5dp</item>
        <item name="strokeColor">@color/card_selected</item>
        <item name="shapeAppearanceOverlay">@style/RoundedImage</item>
    </style>

    <style name="SuitSelectorButton" parent="Widget.MaterialComponents.ShapeableImageView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="layout_constraintDimensionRatio">500:350</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:padding">5dp</item>
        <item name="strokeColor">@color/card_selected</item>
        <item name="shapeAppearanceOverlay">@style/RoundedImage</item>
    </style>

    <style name="HomePageButtons" parent="Widget.Material3.Button">
        <item name="android:layout_height">70dp</item>
        <item name="android:layout_marginHorizontal">30dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>

    <style name="SideButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:layout_margin">1dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="SideTexasHoldemButton" parent="SideButton">
        <item name="android:layout_width">50dp</item>
        <item name="cornerRadius">5dp</item>
    </style>

    <style name="SideOmahaButton" parent="SideButton">
        <item name="android:layout_width">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="layout_constraintDimensionRatio">1:1</item>
    </style>

    <style name="SideTexasHoldemIconButton" parent="SideTexasHoldemButton">
        <item name="iconGravity">textTop</item>
        <item name="iconTint">@color/button_content</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="SideOmahaIconButton" parent="SideOmahaButton">
        <item name="iconGravity">textTop</item>
        <item name="iconTint">@color/button_content</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="BorderedIconButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">35dp</item>
        <item name="iconTint">@color/button_content</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/button_border</item>
    </style>

</resources>
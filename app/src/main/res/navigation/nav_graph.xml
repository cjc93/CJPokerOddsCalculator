<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/TexasHoldemFragment">

    <fragment
        android:id="@+id/TexasHoldemFragment"
        android:name="com.leslie.cjpokeroddscalculator.fragment.TexasHoldemFragment"
        tools:layout="@layout/fragment_equity_calculator">

        <action
            android:id="@+id/action_TexasHoldemFragment_to_RangeSelectorFragment"
            app:destination="@id/RangeSelectorFragment" />

    </fragment>

    <fragment
        android:id="@+id/RangeSelectorFragment"
        android:name="com.leslie.cjpokeroddscalculator.fragment.RangeSelectorFragment"
        tools:layout="@layout/range_selector" />

    <fragment
        android:id="@+id/OmahaHighFragment"
        android:name="com.leslie.cjpokeroddscalculator.fragment.OmahaHighFragment"
        tools:layout="@layout/fragment_equity_calculator">

        <argument
            android:name="cardsPerHand"
            app:argType="integer" />

    </fragment>

    <fragment
        android:id="@+id/OmahaHiLoFragment"
        android:name="com.leslie.cjpokeroddscalculator.fragment.OmahaHiLoFragment"
        tools:layout="@layout/fragment_equity_calculator">

        <argument
            android:name="cardsPerHand"
            app:argType="integer" />

    </fragment>

</navigation>